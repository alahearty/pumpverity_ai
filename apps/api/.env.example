# Local API configuration. Copy to apps/api/.env (gitignored).
PETROSENSE_ENVIRONMENT=development
PETROSENSE_SECRET_KEY=replace-with-at-least-32-random-characters
PETROSENSE_DATABASE_URL=sqlite:///./data/petrosense.db
PETROSENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PETROSENSE_ACCESS_TOKEN_MINUTES=15
PETROSENSE_REFRESH_TOKEN_DAYS=7
PETROSENSE_COOKIE_SECURE=false
PETROSENSE_DEMO_PASSWORD=replace-with-a-strong-demo-password
PETROSENSE_LOG_LEVEL=INFO

# Engineering Copilot / MCP
PETROSENSE_COPILOT_ENABLED=true
PETROSENSE_COPILOT_PROVIDER=deterministic
PETROSENSE_COPILOT_MODEL=gpt-4.1-mini
PETROSENSE_COPILOT_BASE_URL=
PETROSENSE_COPILOT_API_KEY=
PETROSENSE_MCP_TRANSPORT=http
PETROSENSE_MCP_SERVER_URL=http://127.0.0.1:8010/mcp
PETROSENSE_MCP_SERVICE_TOKEN=
PETROSENSE_MCP_HOST=127.0.0.1
PETROSENSE_MCP_PORT=8010
